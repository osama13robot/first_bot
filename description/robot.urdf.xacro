<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="first_bot">
  <xacro:property name="L" value="0.42"/><xacro:property name="W" value="0.30"/><xacro:property name="H" value="0.10"/><xacro:property name="R" value="0.075"/><xacro:property name="WW" value="0.035"/><xacro:property name="X" value="0.14"/><xacro:property name="Y" value="0.16"/>
  <material name="blue"><color rgba="0.05 0.22 0.55 1"/></material><material name="rubber"><color rgba="0.03 0.03 0.03 1"/></material><material name="black"><color rgba="0.01 0.01 0.01 1"/></material>
  <link name="base_link"><visual><origin xyz="0 0 0.09"/><geometry><box size="${L} ${W} ${H}"/></geometry><material name="blue"/></visual><collision><origin xyz="0 0 0.09"/><geometry><box size="${L} ${W} ${H}"/></geometry></collision><inertial><origin xyz="0 0 0.09"/><mass value="2"/><inertia ixx="0.020" ixy="0" ixz="0" iyy="0.032" iyz="0" izz="0.045"/></inertial></link>
  <xacro:macro name="wheel" params="name x y"><link name="${name}_wheel"><visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${R}" length="${WW}"/></geometry><material name="rubber"/></visual><collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${R}" length="${WW}"/></geometry></collision><inertial><mass value="0.15"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial></link><joint name="${name}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${name}_wheel"/><origin xyz="${x} ${y} ${R}"/><axis xyz="0 1 0"/></joint></xacro:macro>
  <xacro:wheel name="front_left" x="${X}" y="${Y}"/><xacro:wheel name="rear_left" x="-${X}" y="${Y}"/><xacro:wheel name="front_right" x="${X}" y="-${Y}"/><xacro:wheel name="rear_right" x="-${X}" y="-${Y}"/>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.045" length="0.05"/></geometry><material name="black"/></visual><collision><geometry><cylinder radius="0.045" length="0.05"/></geometry></collision></link><joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.19"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.08 0.05 0.04"/></geometry><material name="black"/></visual></link><joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.18 0 0.18"/></joint><link name="camera_optical_frame"/><joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <link name="imu_link"><visual><geometry><box size="0.04 0.04 0.02"/></geometry><material name="black"/></visual></link><joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.15"/></joint>
  <gazebo reference="base_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="front_left_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo><gazebo reference="rear_left_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo><gazebo reference="front_right_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo><gazebo reference="rear_right_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><topic>/cmd_vel</topic><left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint><right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint><wheel_separation>0.32</wheel_separation><wheel_radius>0.075</wheel_radius><odom_publish_frequency>50</odom_publish_frequency><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id></plugin></gazebo>
  <gazebo reference="lidar_link"><sensor name="lidar" type="gpu_lidar"><update_rate>10</update_rate><topic>/scan</topic><frame_id>lidar_link</frame_id><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
  <gazebo reference="camera_link"><sensor name="rgbd_camera" type="rgbd_camera"><update_rate>15</update_rate><topic>/camera</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera></sensor></gazebo>
  <gazebo reference="imu_link"><sensor name="imu_sensor" type="imu"><always_on>true</always_on><update_rate>100</update_rate><topic>/imu/data</topic><frame_id>imu_link</frame_id></sensor></gazebo>
</robot>
