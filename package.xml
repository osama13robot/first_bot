<?xml version="1.0"?>
<package format="3">
  <name>first_bot</name>
  <version>0.1.0</version>
  <description>3D-printable RC-style mobile robot simulation platform for ROS 2 autonomy development.</description>
  <maintainer email="osama.mechatronics.13@gmail.com">Osama Kamal</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
